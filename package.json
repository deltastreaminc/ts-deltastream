{
  "type": "module",
  "name": "@deltastream/sdk",
  "version": "0.5.5",
  "description": "Official DeltaStream sdk for Node.js",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "scripts": {
    "build": "tsup",
    "lint": "tsc",
    "dev": "vitest",
    "test": "vitest run  --coverage",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run build && changeset publish",
    "format": "prettier --write ."
  },
  "keywords": [
    "deltastream",
    "kafka",
    "streaming",
    "realtime"
  ],
  "author": "DeltaStream Inc.",
  "license": "Apache-2.0",
  "homepage": "https://deltastream.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/deltastreaminc/ts-deltastream"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^20.19.41",
    "@types/ws": "^8.18.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "brace-expansion": "^2.1.7",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "tar-fs": "^3.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "undici": "^7.28.0",
    "vitest": "^4.1.11",
    "webdriverio": "^9.32.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "brace-expansion": "^2.1.7",
    "geckodriver": "^5.0.0",
    "isomorphic-ws": "^5.0.0",
    "mathjs": "^15.2.0",
    "tar-fs": "^3.1.3",
    "undici": "^7.28.0",
    "ws": "^8.21.0"
  },
  "msw": {
    "workerDirectory": [
      "src/fixtures/msw"
    ]
  },
  "overrides": {
    "rollup": "^4.64.3",
    "esbuild": "0.28.1",
    "undici": "$undici",
    "webdriver": {
      "undici": "^7.28.0"
    },
    "cheerio": {
      "undici": "^7.28.0"
    },
    "minimatch": "^9.0.9",
    "fast-xml-parser": "^5.7.0",
    "lodash": "^4.18.1",
    "geckodriver": {
      "tar-fs": "^3.1.3"
    },
    "brace-expansion": "^2.1.7",
    "ip-address": "^10.7.3",
    "basic-ftp": "^6.2.3",
    "source-map-js": "^1.2.2",
    "shell-quote": "^1.12.0"
  },
  "pnpm": {
    "overrides": {
      "webdriver@9.29.1>undici": "^7.28.0",
      "webdriver@9.32.0>undici": "^7.28.0",
      "webdriverio@9.29.1>webdriver@9.29.1>undici": "^7.28.0",
      "esbuild": "0.28.1",
      "vite>esbuild": "0.28.1",
      "tsup>esbuild": "0.28.1",
      "bundle-require>esbuild": "0.28.1",
      "rollup": "^4.64.3",
      "geckodriver>tar-fs": "^3.1.3",
      "brace-expansion": "^2.1.7",
      "ip-address": "^10.7.3",
      "basic-ftp": "^6.2.3",
      "source-map-js": "^1.2.2",
      "shell-quote": "^1.12.0"
    }
  }
}
